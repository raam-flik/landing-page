  "trailingSlash": true,
  "redirects": [
    { "source": "/v4/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/v3/:path*", "destination": "/:path*", "permanent": false },
    { "source": "/brand/dashboard/:path*", "destination": "/dashboard/", "permanent": false },
    { "source": "/brand/:path*", "destination": "/", "permanent": false },
    { "source": "/v1/:path*", "destination": "/", "permanent": false },
    { "source": "/v2/:path*", "destination": "/", "permanent": false }
  ]
}
